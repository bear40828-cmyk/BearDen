# BearDen 配置：cp .env.example .env 后填好再用。值全留空或占位，绝不填真值。
# Docker（docker compose up -d）和本地跑服务都读这一份。

# ---- 内置 API 工人（必填，否则工人启动不了）----
# 模型接口地址（OpenAI 兼容，只填到 /v1，不要带 /chat/completions）
AI_BASE_URL=
# 模型接口密钥
AI_API_KEY=
# 模型名：DeepSeek 用 deepseek-chat，Kimi 用 kimi-k2.5，GLM 用 glm-4.6
AI_MODEL=
# 可选：私聊默认提示，不填用内置通用提示
AI_SYSTEM_PROMPT=
# 工人与聊天服务器之间的共享口令：生产部署换成随机值
WORKER_TOKEN=

# ---- 朋友圈服务 ----
MOMENTS_TOKEN_ASSISTANT=
MOMENTS_TOKEN_ASSISTANT_2=
MOMENTS_OWNER_PW=
